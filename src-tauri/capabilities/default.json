{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Qbot 三端默认能力：核心 IPC、SQLite、配置存储、文件系统、对话框、本地通知、HTTP",
  "platforms": ["linux", "windows", "android"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "store:default",
    "fs:default",
    "dialog:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*" },
        { "url": "https://*:*" },
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "ws://*:*" },
        { "url": "wss://*:*" }
      ]
    }
  ]
}
